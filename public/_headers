# Cloudflare Pages headers.
#
# Pages guesses content types from the file extension and does not know the HLS
# ones, so the playlist and segments need stating explicitly. Without the
# playlist type, Safari's native player refuses the stream outright.
/assets/investments/economic-hub/*.m3u8
  Content-Type: application/vnd.apple.mpegurl
  Cache-Control: public, max-age=300

/assets/investments/economic-hub/*.m4s
  Content-Type: video/iso.segment
  Cache-Control: public, max-age=31536000, immutable

/assets/investments/economic-hub/init.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=31536000, immutable
