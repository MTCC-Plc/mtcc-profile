# Build-time values inlined into the browser bundle by `next build`.
# Copy to .env.local for local previews; set them as build variables on the
# Cloudflare Worker for deployments.
#
# Where the dialog posts enquiries. Defaults to /api/enquiry (the Worker).
# Set to `mailto` for a build with no Worker so the
# dialog opens an email draft instead.
# NEXT_PUBLIC_ENQUIRY_ENDPOINT=/api/enquiry
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
