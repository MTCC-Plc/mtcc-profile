# Build-time values inlined into the browser bundle by `next build`.
# Copy to .env.local for local previews; set them as build variables on the
# Cloudflare Worker for deployments. Leave both unset for GitHub Pages so
# the dialog keeps opening an email draft.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=/api/enquiry
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
