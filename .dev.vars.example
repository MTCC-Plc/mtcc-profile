# Copy to .dev.vars for `pnpm preview` (wrangler dev). Never commit .dev.vars.
# Full value of the Authorization header Herald expects.
HERALD_API_KEY=
# Turnstile secret key from the Cloudflare dashboard. Leave empty to skip
# verification locally; the matching site key goes in .env.local as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# Optional overrides of the values in wrangler.jsonc.
# HERALD_URL=
# ENQUIRY_TO=
